<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Keep consistent modern blue-white theme across day/night for Campus Impact Hub -->
    <style name="Theme.CampusImpactHub" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/impact_green</item>
        <item name="colorSecondaryVariant">@color/impact_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_blue_dark</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
    </style>
</resources>
